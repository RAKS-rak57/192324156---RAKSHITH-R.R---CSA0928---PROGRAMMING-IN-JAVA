digraph G { rankdir=LR; node [shape=box, fontname="Helvetica", fontsize=11, style="rounded,filled", fillcolor="#FFFFFF"]; 
IO [label="Storage.save()\n\nnew IOException(\"Disk quota exceeded\")\nthrown by the disk simulation", fillcolor="#F8D7D7"];
ST [label="Storage.save()  catch (IOException e)\n\nthrow new SubmissionStorageException(\n  \"Could not store ...\", e)   <- cause kept", fillcolor="#FFF4D6"];
SV [label="SubmissionService.submit()\n\ndeclares  throws ExamException\nno catch: exception PROPAGATES", fillcolor="#FFF4D6"];
