digraph ER { rankdir=LR; nodesep=0.7; ranksep=1.0; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica"];
 labelloc=t; fontname="Helvetica-Bold"; fontsize=14;
 label="ER diagram - Task 1: Student fee payment";
student [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>STUDENT</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">reg_no  VARCHAR(12)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">name  VARCHAR(60)</td></tr></table>>];
fees [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>FEES</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">payment_id  INT AUTO_INCREMENT</td></tr><tr><td align="left" width="34"><b>FK</b></td><td align="left">reg_no  VARCHAR(12)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">amount  DECIMAL(10,2)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">paid_on  TIMESTAMP</td></tr></table>>];
student -> fees [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  pays (1 : N)  ", fontname="Helvetica", fontsize=11];
}