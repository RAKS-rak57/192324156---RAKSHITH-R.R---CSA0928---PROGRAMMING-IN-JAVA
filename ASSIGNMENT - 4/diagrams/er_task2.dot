digraph ER { rankdir=LR; nodesep=0.7; ranksep=1.0; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica"];
 labelloc=t; fontname="Helvetica-Bold"; fontsize=14;
 label="ER diagram - Task 2: Outpatient appointment desk";
department [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>DEPARTMENT</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">dept_id  INT</td></tr><tr><td align="left" width="34"><b>UK</b></td><td align="left">name  VARCHAR(40)</td></tr></table>>];
doctor [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>DOCTOR</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">doctor_id  VARCHAR(8)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">name  VARCHAR(60)</td></tr><tr><td align="left" width="34"><b>FK</b></td><td align="left">dept_id  INT</td></tr></table>>];
patient [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>PATIENT</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">patient_id  VARCHAR(8)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">name  VARCHAR(60)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">phone  VARCHAR(15)</td></tr></table>>];
appointment [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>APPOINTMENT</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">appt_id  INT AUTO_INCREMENT</td></tr><tr><td align="left" width="34"><b>FK</b></td><td align="left">patient_id  VARCHAR(8)</td></tr><tr><td align="left" width="34"><b>FK</b></td><td align="left">doctor_id  VARCHAR(8)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">appt_date  DATE</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">slot_time  CHAR(5)</td></tr><tr><td align="left" width="34"><b>UK</b></td><td align="left">(doctor_id, appt_date, slot_time)</td></tr></table>>];
department -> doctor [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  has (1 : N)  ", fontname="Helvetica", fontsize=11];
patient -> appointment [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  books (1 : N)  ", fontname="Helvetica", fontsize=11];
doctor -> appointment [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  is booked in (1 : N)  ", fontname="Helvetica", fontsize=11];
}