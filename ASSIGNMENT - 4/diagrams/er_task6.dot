digraph ER { rankdir=LR; nodesep=0.7; ranksep=1.0; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica"];
 labelloc=t; fontname="Helvetica-Bold"; fontsize=14;
 label="ER diagram - Task 6: Campus event registration (M : N resolved by REGISTRATION)";
student [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>STUDENT</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">reg_no  VARCHAR(12)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">name  VARCHAR(60)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">email  VARCHAR(80)</td></tr></table>>];
registration [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>REGISTRATION</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">reg_id  INT AUTO_INCREMENT</td></tr><tr><td align="left" width="34"><b>FK</b></td><td align="left">reg_no  VARCHAR(12)</td></tr><tr><td align="left" width="34"><b>FK</b></td><td align="left">event_id  INT</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">registered_on  TIMESTAMP</td></tr><tr><td align="left" width="34"><b>UK</b></td><td align="left">(reg_no, event_id)  <i>one per student per event</i></td></tr></table>>];
event [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>EVENT</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">event_id  INT AUTO_INCREMENT</td></tr><tr><td align="left" width="34"><b>UK</b></td><td align="left">title  VARCHAR(80)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">venue  VARCHAR(60)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">event_date  DATE</td></tr></table>>];
student -> registration [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  registers (1 : N)  ", fontname="Helvetica", fontsize=11];
event -> registration [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  receives (1 : N)  ", fontname="Helvetica", fontsize=11];
}