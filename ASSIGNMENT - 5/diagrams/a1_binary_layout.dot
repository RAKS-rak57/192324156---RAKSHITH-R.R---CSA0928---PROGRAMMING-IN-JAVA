digraph G { node [fontname="Helvetica", fontsize=11, shape=plain]; labelloc=t; label="A1.1(b) Binary file written with DataOutputStream (variable length records)"; fontname="Helvetica-Bold";
 rec [label=<<table border="1" cellborder="1" cellspacing="0"><tr><td bgcolor="#DDE8F7" cellpadding="6"><b>passId</b><br/><font point-size="9">writeUTF: 2-byte length + UTF-8</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>regNo</b><br/><font point-size="9">writeUTF</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>name</b><br/><font point-size="9">writeUTF</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>route</b><br/><font point-size="9">writeInt: 4 bytes</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>stop</b><br/><font point-size="9">writeUTF</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>validity</b><br/><font point-size="9">writeLong: epoch day, 8 bytes</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>amount</b><br/><font point-size="9">writeDouble: 8 bytes</font></td></tr></table>>];
 note [shape=box, style="rounded,filled", fillcolor="#FFF2CC", label="No delimiter is needed: every text field starts with its own length, so a name that contains a comma (or any character) is stored unchanged.\nThe reader must read the fields in EXACTLY this order (readUTF, readUTF, readUTF, readInt, readUTF, readLong, readDouble).\nA record is about 2+5 + 2+9 + 2+12 + 4 + 2+9 + 8 + 8 = 63 bytes for typical values."];
 rec -> note [style=invis]; }