digraph G { node [fontname="Helvetica", fontsize=11, shape=plain]; labelloc=t; label="Alternative: fixed-length records in a RandomAccessFile (92 bytes per record)"; fontname="Helvetica-Bold";
 rec [label=<<table border="1" cellborder="1" cellspacing="0"><tr><td bgcolor="#DDE8F7" cellpadding="6"><b>passId</b><br/><font point-size="9">8 bytes</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>regNo</b><br/><font point-size="9">12</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>name</b><br/><font point-size="9">30</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>route</b><br/><font point-size="9">4 (int)</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>stop</b><br/><font point-size="9">20</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>validity</b><br/><font point-size="9">10</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>amount</b><br/><font point-size="9">8 (double)</font></td></tr></table>>];
 note [shape=box, style="rounded,filled", fillcolor="#FFF2CC", label="record i starts at byte  i x 92   ->   seek(i * 92); read 92 bytes      (O(1))\ntext fields are padded with spaces up to their fixed width: the padding is the wasted space"];
 rec -> note [style=invis]; }