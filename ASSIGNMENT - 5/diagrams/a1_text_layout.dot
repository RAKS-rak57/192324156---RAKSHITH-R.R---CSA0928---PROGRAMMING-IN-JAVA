digraph G { node [fontname="Helvetica", fontsize=11, shape=plain]; labelloc=t; label="A1.1(a) Delimited text file: one pass = one line, 8 fields separated by commas"; fontname="Helvetica-Bold";
 line [label=<<table border="1" cellborder="1" cellspacing="0"><tr><td bgcolor="#DDE8F7" cellpadding="6"><b>passId</b><br/><font point-size="9">P1001</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>regNo</b><br/><font point-size="9">192311001</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>name</b><br/><font point-size="9">Kumar\\, Meena</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>route</b><br/><font point-size="9">12</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>stop</b><br/><font point-size="9">Main Gate</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>validity</b><br/><font point-size="9">2027-06-30</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>amount</b><br/><font point-size="9">4500.00</font></td><td bgcolor="#DDE8F7" cellpadding="6"><b>crc32</b><br/><font point-size="9">84b0f00e</font></td></tr></table>>];
 rule [shape=box, style="rounded,filled", fillcolor="#FFF2CC", label="Delimiter = comma.  Escape rules inside a field:  ,  ->  \\,      \\  ->  \\\\      line break  ->  \\n\nSplit only at commas that are NOT escaped.  crc32 = checksum of the first seven fields."];
 ex [shape=box, style="rounded,filled", fillcolor="#E2F0D9", label="Example line (the name is  Kumar, Meena):\nP1001,192311001,Kumar\\, Meena,12,Main Gate,2027-06-30,4500.00,84b0f00e\n(file is ended by a line break after every record)"];
 line -> rule [style=invis]; rule -> ex [style=invis]; }