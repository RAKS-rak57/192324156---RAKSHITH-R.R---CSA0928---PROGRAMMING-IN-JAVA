digraph ER { rankdir=LR; nodesep=0.7; ranksep=1.0; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica"]; labelloc=t; fontname="Helvetica-Bold"; fontsize=14;
 label="ER diagram - Task A3: student, course and marks";
student [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>STUDENT</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">reg_no  VARCHAR(12)   <i>Student.regNo</i></td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">name  VARCHAR(60)   <i>Student.name</i></td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">email  VARCHAR(80)   <i>Student.email</i></td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">year_no  INT   <i>Student.year</i></td></tr></table>>];
course [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>COURSE</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">course_code  VARCHAR(10)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">title  VARCHAR(80)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">credits  INT</td></tr></table>>];
marks [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>MARKS</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">mark_id  INT</td></tr><tr><td align="left" width="34"><b>FK</b></td><td align="left">reg_no  VARCHAR(12)</td></tr><tr><td align="left" width="34"><b>FK</b></td><td align="left">course_code  VARCHAR(10)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">marks  INT</td></tr></table>>];
student -> marks [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  scores (1 : N)  ", fontname="Helvetica", fontsize=11];
course -> marks [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  is scored in (1 : N)  ", fontname="Helvetica", fontsize=11];
}