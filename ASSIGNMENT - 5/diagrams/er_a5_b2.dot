digraph ER { rankdir=LR; nodesep=0.7; ranksep=1.0; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica"]; labelloc=t; fontname="Helvetica-Bold"; fontsize=14;
 label="ER diagrams - Task A5 (wallet transfer) and Task B2 (login)";
account [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>ACCOUNT</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">acc_id  VARCHAR(16)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">balance  DECIMAL(10,2)  CHECK (balance &gt;= 0)</td></tr></table>>];
users [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>USERS (test database only)</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">user_no  INT</td></tr><tr><td align="left" width="34"><b>UK</b></td><td align="left">id  VARCHAR(20)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">pwd  VARCHAR(40)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">role  VARCHAR(10)</td></tr></table>>];
}