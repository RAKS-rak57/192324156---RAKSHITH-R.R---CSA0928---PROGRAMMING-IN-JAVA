digraph ER { rankdir=LR; nodesep=0.7; ranksep=1.0; node [fontname="Helvetica", fontsize=11]; edge [fontname="Helvetica"]; labelloc=t; fontname="Helvetica-Bold"; fontsize=14;
 label="ER diagram - Task B4: bus passes for 12 campuses";
campus [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>CAMPUS</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">campus_id  INT</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">name  VARCHAR(40)  <i>(12 rows)</i></td></tr></table>>];
pass [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>BUS_PASS_FULL</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">pass_id  VARCHAR(10)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">reg_no  VARCHAR(12)  <i>index idx_pass_reg</i></td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">name  VARCHAR(60)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">route_no  INT  <i>index idx_pass_route</i></td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">boarding_stop  VARCHAR(30)</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">validity_date  DATE</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">amount  DECIMAL(8,2)</td></tr><tr><td align="left" width="34"><b>FK</b></td><td align="left">campus_id  INT</td></tr></table>>];
issued [shape=plain, label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5"><tr><td colspan="2" bgcolor="#2F5496"><font color="white"><b>ISSUED (counter log)</b></font></td></tr><tr><td align="left" width="34"><b>PK</b></td><td align="left">pass_no  INT AUTO_INCREMENT  <i>unique number for every counter</i></td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">counter_no  INT</td></tr><tr><td align="left" width="34"><b>&nbsp;&nbsp;</b></td><td align="left">issued_at  TIMESTAMP</td></tr></table>>];
campus -> pass [dir=both, arrowtail=teetee, arrowhead=crowodot, label="  issues (1 : N)  ", fontname="Helvetica", fontsize=11];
}